// (c) TradingViewProject
// Strategy B.007 — Short Only + V1.006/V1.007 filters
// Plus Breakout Long signal (alert only)
//
//@version=5
strategy("strategy_MTT_v1.B007 (Short + Regime)",
     shorttitle="B.007 S+R",
     overlay=true,
     initial_capital=100000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=10,
     commission_type=strategy.commission.percent,
     commission_value=0.075,
     slippage=2,
     pyramiding=0,
     calc_on_every_tick=false,
     process_orders_on_close=true)

grp_p = "Trading Profile"
profile  = input.string("Futures", "Profile", options=["Margin","Futures"], group=grp_p)
override_qty = input.bool(false, "Override qty %", group=grp_p)
manual_qty   = input.float(10.0, "Manual qty %", minval=1.0, maxval=500.0, group=grp_p)

grp_ma = "MA"
ma_type  = input.string("EMA", "Type", options=["SMA","EMA","WMA","HMA","DEMA","TEMA"], group=grp_ma)
fast_len = input.int(20, "Fast", minval=5, group=grp_ma)
med_len  = input.int(50, "Medium", minval=10, group=grp_ma)
slow_len = input.int(100, "Slow", minval=20, group=grp_ma)

grp_f6 = "V1.006 Filters"
use_slope = input.bool(false, "Slope DOWN filter", group=grp_f6)
slope_lb  = input.int(20, "Slope lookback", group=grp_f6)
use_trail = input.bool(true, "ATR trailing stop", group=grp_f6)
atr_len   = input.int(14, "ATR length", group=grp_f6)
atr_mult  = input.float(2.5, "ATR mult", group=grp_f6)

grp_f7 = "V1.007 Regime / Time"
use_adx       = input.bool(true,  "ADX regime gate", group=grp_f7)
adx_len       = input.int(14,    "ADX length", group=grp_f7)
adx_threshold = input.float(20,  "ADX threshold", group=grp_f7)
use_bb_sq     = input.bool(true,  "Block on BB squeeze", group=grp_f7)
bb_len        = input.int(20,    "BB length", group=grp_f7)
bb_mult       = input.float(2.0, "BB stdev mult", group=grp_f7)
bb_sq_th      = input.float(5.0, "BB width % squeeze threshold", group=grp_f7)
use_time_stop = input.bool(true,  "Time-based stop", group=grp_f7)
max_hold_bars = input.int(20,    "Max bars hold w/o profit", group=grp_f7)

ma(t, l) =>
    switch t
        "SMA"  => ta.sma(close, l)
        "EMA"  => ta.ema(close, l)
        "WMA"  => ta.wma(close, l)
        "HMA"  => ta.hma(close, l)
        "DEMA" => 2 * ta.ema(close, l) - ta.ema(ta.ema(close, l), l)
        "TEMA" => 3 * (ta.ema(close, l) - ta.ema(ta.ema(close, l), l)) + ta.ema(ta.ema(ta.ema(close, l), l), l)
        =>        ta.sma(close, l)

mf = ma(ma_type, fast_len)
mm = ma(ma_type, med_len)
ms = ma(ma_type, slow_len)
bear = mf < mm and mm < ms
bear_start = bear and not bear[1]
bear_end   = not bear and bear[1]

up_move   = ta.change(high)
down_move = -ta.change(low)
plus_dm   = up_move > down_move and up_move > 0 ? up_move : 0.0
minus_dm  = down_move > up_move and down_move > 0 ? down_move : 0.0
atr_a     = ta.rma(ta.tr, adx_len)
plus_di   = 100 * ta.rma(plus_dm,  adx_len) / atr_a
minus_di  = 100 * ta.rma(minus_dm, adx_len) / atr_a
dx        = 100 * math.abs(plus_di - minus_di) / (plus_di + minus_di)
adx       = ta.rma(dx, adx_len)

basis = ta.sma(close, bb_len)
dev   = bb_mult * ta.stdev(close, bb_len)
bb_w_pct = 100 * (2 * dev) / basis

slope_ok    = not use_slope or mm < mm[slope_lb]
trending    = not use_adx   or adx > adx_threshold
no_squeeze  = not use_bb_sq or bb_w_pct >= bb_sq_th
entry_ok = bear_start and slope_ok and trending and no_squeeze

atr_v = ta.atr(atr_len)
in_pos = strategy.position_size < 0
var float trail = na
if in_pos
    new_trail = close + atr_mult * atr_v
    trail := na(trail) ? new_trail : math.min(trail, new_trail)
else
    trail := na
trail_hit = use_trail and in_pos and not na(trail) and high >= trail

var int entry_bar = 0
var float entry_price = na
if bear_start and entry_ok
    entry_bar := bar_index
    entry_price := close
bars_held = in_pos ? bar_index - entry_bar : 0
time_stop = use_time_stop and in_pos and bars_held >= max_hold_bars and close >= entry_price

margin_pct  = 20.0
futures_pct = 10.0
qty_pct = override_qty ? manual_qty : (profile == "Margin" ? margin_pct : futures_pct)
qc = (strategy.equity * qty_pct / 100.0) / close

if entry_ok
    strategy.entry("SHORT", strategy.short, qty=qc, comment="Bear+Filters")
if bear_end
    strategy.close("SHORT", comment="Bear End")
if trail_hit
    strategy.close("SHORT", comment="ATR Trail")
if time_stop
    strategy.close("SHORT", comment="Time Stop")

// Breakout Long alert (no trade)
breakout_long = bear_end
alertcondition(breakout_long, title="Breakout Long Signal", message="Bear stack ended → potential long break-out")

// Visuals
p_f = plot(mf, color=color.blue, title="Fast")
p_m = plot(mm, color=color.orange, title="Medium")
p_s = plot(ms, color=color.red, title="Slow", linewidth=2)
fill(p_f, p_s, color=bear ? color.new(color.red, 80) : na, title="Bear Zone")
plot(use_trail and in_pos ? trail : na, color=color.fuchsia, style=plot.style_linebr, linewidth=2, title="ATR Trail")

bgcolor(use_adx and adx <= adx_threshold ? color.new(color.yellow, 92) : na, title="Sideway")
bgcolor(use_bb_sq and bb_w_pct < bb_sq_th ? color.new(color.aqua, 92) : na, title="BB Squeeze")

plotshape(entry_ok,    title="Entry S",  style=shape.triangledown, location=location.abovebar, color=color.new(color.red,0), size=size.tiny, text="S")
plotshape(bear_start and not entry_ok, title="Filtered", style=shape.xcross, location=location.abovebar, color=color.new(color.gray,0), size=size.tiny)
plotshape(bear_end,    title="Bear End", style=shape.xcross,       location=location.belowbar, color=color.new(color.red,30), size=size.tiny)
plotshape(trail_hit,   title="Trail",    style=shape.diamond,      location=location.belowbar, color=color.new(color.fuchsia,0), size=size.small, text="T")
plotshape(time_stop,   title="Time Stop", style=shape.diamond,     location=location.belowbar, color=color.new(color.orange,0),  size=size.small, text="TS")
plotshape(breakout_long, title="BO",     style=shape.diamond,      location=location.belowbar, color=color.new(color.aqua,0),    size=size.small, text="BO")
