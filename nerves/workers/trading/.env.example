# ════════════════════════════════════════════════════════════════
# .env.example — Minervini AI Trading Bot (Server C)
# Copy to .env and fill in your values.
# NEVER commit the real .env with secrets to version control.
# ════════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
DEBUG=false

# ── Security ─────────────────────────────────────────────────────
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=your_webhook_secret_here

# Dashboard API token (bearer auth for /api/* endpoints) - Leave blank for local open access
DASHBOARD_TOKEN=
AUTH_SECRET_KEY=your_auth_secret_key_here

# TradingView IP whitelist (enable in production)
ENABLE_IP_WHITELIST=false

# ── Database ─────────────────────────────────────────────────────
DB_PATH=trades.db
FORWARD_DB_PATH=nerves/workers/trading/forward_trades.db
FORWARD_TEST_ENABLED=true
FORWARD_TEST_INITIAL_CAPITAL=10000.0
FORWARD_TEST_POSITION_SIZE=100.0
LOG_FILE=trades.log

# ── Binance API ──────────────────────────────────────────────────
# Get keys at: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
# IMPORTANT: Set to false ONLY when ready for real trading
BINANCE_DRY_RUN=true

# ── Risk Management (Minervini SEPA) ─────────────────────────────
RISK_PER_TRADE=0.02
STOP_LOSS_PCT=0.08
TAKE_PROFIT_PCT=0.20

# ── Notifications ────────────────────────────────────────────────
# Telegram Bot: create via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_ENABLED=false

# Discord webhook (optional)
DISCORD_WEBHOOK_URL=

# ── RAG / Knowledge Base ─────────────────────────────────────────
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic
RAG_ENABLED=true
RAG_TOP_K=3

# ── MCP Configuration ────────────────────────────────────────────
MCP_ENABLED=true
MCP_CDP_PORT=9222

# ── Chart Capture Configuration ──────────────────────────────────
# Options: mplfinance | lightweight-charts | daemon
CHART_CAPTURE_METHOD=mplfinance
CHART_CANDLES_COUNT=100
CHART_CCXT_FALLBACK=true

# ── Morning Brief ────────────────────────────────────────────────
BRIEF_ENABLED=false
BRIEF_CRON_TIME=07:00

# ── Watchlist ────────────────────────────────────────────────────
WATCHLIST_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# ── Angati Isolated Satellite ────────────────────────────────────
ANGATI_AGENTS_ROOT=/path/to/TradingViewProject
ANGATI_BUS_BIND=127.0.0.1:9105

# ── Weex API (optional alternative exchange) ─────────────────────
WEEX_API_KEY=
WEEX_API_SECRET=
WEEX_PASSPHRASE=
WEEX_TESTNET=true
WEEX_DRY_RUN=true

# ── Pipeline Forwarding & Failover ───────────────────────────────
# Identifier of this execution server
EXECUTION_TARGET_NAME=Local

# Secret to authenticate /api/execute-trade requests TO this server
SERVER_B_SECRET=your_server_b_secret_here

# Routing from Server C outbound
LOCAL_EXECUTE_URL=http://localhost:5000
LOCAL_EXECUTE_SECRET=your_local_execute_secret
SERVER_B_EXECUTE_URL=http://YOUR_SERVER_B_IP:5000

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log
LOG_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=5
LOG_JSON_FORMAT=false

# ── Monitoring ───────────────────────────────────────────────────
# Server A and B health URLs (Tailscale IPs)
SERVER_A_HEALTH_URL=http://SERVER_A_IP:5000/health
SERVER_B_HEALTH_URL=http://SERVER_B_IP:5002/health

# Clock drift alert threshold (ms) — Binance rejects > 1000ms
NTP_DRIFT_THRESHOLD_MS=500

# Disk usage alert thresholds
DISK_WARNING_THRESHOLD_PCT=80
DISK_CRITICAL_THRESHOLD_PCT=90

# Liveness: alert after N consecutive failures
LIVENESS_ALERT_AFTER_FAILURES=2

# Long Polling config
LONG_POLL_TIMEOUT_SEC=30

# ── VPS Buffer Consumer ──────────────────────────────────────────
VPS_BUFFER_ENABLED=false
VPS_BUFFER_URL=http://SERVER_A_IP:5000
VPS_BUFFER_SECRET=your_vps_buffer_secret
VPS_BUFFER_SOURCE_FILTER=indicator
